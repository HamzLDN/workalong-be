# Copy to .env and fill in. Never commit .env (see .gitignore).

PORT=8080
# HTTP port when NODE_ENV=dev (npm run dev). Overrides PORT for local API bind.
DEV_PORT=8081

# Stripe (use test keys in development)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# PostgreSQL
DB_USER=workalong
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=users

# Email (if using SMTP)
EMAIL=
EMAIL_PASSWORD=

# Required in production: set a long random value (e.g. openssl rand -hex 32)
SESSION_SECRET=

# Rate limiting (/api): applied in all environments unless disabled.
# Production defaults come from createRateLimiter in index.js unless overridden:
# RATE_LIMIT_PER_MINUTE=100
# RATE_LIMIT_PER_HOUR=5000
# Development uses high ceilings so local workflows rarely hit limits:
# RATE_LIMIT_PER_MINUTE_DEV=2500
# RATE_LIMIT_PER_HOUR_DEV=50000
# RATE_LIMIT_DISABLED=true
#
# Burst of HTTP 401/403 from one IP (possible credential stuffing); logs auth_failure_burst once per window.
# AUTH_FAILURE_BURST_THRESHOLD=40

# Proxy /api/admin and /api/support to admin_panel/server (coupons, operator chat, etc.).
# Local dev: defaults to http://127.0.0.1:15055 when NODE_ENV=dev (same as admin_panel default port).
# Docker/production: set explicitly, e.g. http://admin-panel-api:5055
# ADMIN_PANEL_API_URL=http://127.0.0.1:15055
# Set to false to disable proxy (e.g. CI hitting only main API; admin routes return 404 from this server).
# ADMIN_PANEL_PROXY=false
