{
  "name": "workalong-server",
  "version": "1.0.0",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "start:with-tests": "npm test && node index.js",
    "dev": "NODE_ENV=dev DISABLE_OBFUSCATION=true nodemon index.js",
    "dev:secure": "NODE_ENV=dev nodemon index.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write \"**/*.{js,json}\"",
    "format:check": "prettier --check \"**/*.{js,json}\"",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "create-free-promo": "node scripts/create-free-promo-code.js",
    "list-promo-codes": "node scripts/list-promo-codes.js",
    "grant-free-access": "node scripts/grant-free-access.js",
    "migrate:discount": "node scripts/run-discount-migration.js",
    "migrate:time-entry-approval": "node scripts/run-time-entry-approval-migration.js",
    "db:compare": "bash scripts/compare-db-schemas.sh",
    "migrate:prod": "node scripts/run-migrations-for-prod.js",
    "schema:sync:prod": "node scripts/run-migrations-for-prod.js"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "http-proxy-middleware": "^3.0.5",
    "nodemailer": "^7.0.12",
    "nodemon": "^3.1.11",
    "pg": "^8.11.3",
    "qrcode": "^1.5.3",
    "speakeasy": "^2.0.0",
    "stripe": "^20.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.2.0",
    "eslint": "^8.57.0",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "prettier": "^3.4.0",
    "supertest": "^7.2.2"
  }
}
